#!/bin/bash
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "$0")" && pwd)"
DB="$PROJECT_ROOT/.specdd/state.db"

if [ ! -f "$DB" ]; then
  echo "Error: $DB not found. Run 'specdd init' first."
  exit 1
fi

# Use Python's built-in sqlite3 — no system sqlite3 binary required
_query() {
  python3 -c "
import sqlite3, sys
try:
    conn = sqlite3.connect('$DB')
    conn.execute('PRAGMA journal_mode=WAL')
    row = conn.execute(sys.argv[1]).fetchone()
    print('|'.join(str(c) for c in row) if row else '')
    conn.close()
except Exception as e:
    print('ERROR:' + str(e), file=sys.stderr)
    sys.exit(1)
" "$1"
}

SLEEP_INITIAL=10
SLEEP_MAX=300
SLEEP_CURRENT=$SLEEP_INITIAL

# Read implementer model from config (falls back to empty string = CLI default)
IMPLEMENTER_MODEL=$(python3 -c "
import yaml, sys
try:
    cfg = yaml.safe_load(open('$PROJECT_ROOT/.specdd/config.yml'))
    print(cfg.get('models', {}).get('implementer', ''))
except Exception:
    pass
" 2>/dev/null || true)

trap 'echo "[$(date +%H:%M:%S)] Stopping loop."; exit 0' INT TERM

echo "[$(date +%H:%M:%S)] SpecDD implementer loop starting."
echo "[$(date +%H:%M:%S)] Project: $PROJECT_ROOT"

while true; do
  # Cheap SQL check — no model invoked
  NEXT_SQL="SELECT id||'|'||complexity FROM tasks WHERE status='TODO' OR (status='IN_PROGRESS' AND NOT EXISTS (SELECT 1 FROM task_events e WHERE e.task_id = tasks.id AND e.created_at > datetime('now', '-5 seconds'))) ORDER BY (CASE status WHEN 'TODO' THEN 0 ELSE 1 END), priority, created_at LIMIT 1"

  if ! NEXT=$(_query "$NEXT_SQL" 2>&1); then
    echo "[$(date +%H:%M:%S)] DB query failed: $NEXT"
    echo "[$(date +%H:%M:%S)] Pausing 30s before retry."
    sleep 30
    continue
  fi

  if [ -z "$NEXT" ]; then
    echo "[$(date +%H:%M:%S)] Queue empty. Sleeping ${SLEEP_CURRENT}s."
    sleep "$SLEEP_CURRENT"
    SLEEP_CURRENT=$(( SLEEP_CURRENT * 2 ))
    [ $SLEEP_CURRENT -gt $SLEEP_MAX ] && SLEEP_CURRENT=$SLEEP_MAX
    continue
  fi

  SLEEP_CURRENT=$SLEEP_INITIAL
  TASK_ID="${NEXT%%|*}"
  COMPLEXITY="${NEXT##*|}"

  if [ -z "$TASK_ID" ] || [ -z "$COMPLEXITY" ]; then
    echo "[$(date +%H:%M:%S)] Malformed DB result: '$NEXT'. Pausing."
    exit 1
  fi

  echo "[$(date +%H:%M:%S)] Task #$TASK_ID ($COMPLEXITY) ready. Invoking Gemini."

  # Gemini runs in agentic mode — multi-turn within one invocation.
  # If complete_task returns an error (tests failed), Gemini sees it and retries
  # in the same session. The script only resumes when Gemini exits.
  MODEL_FLAG=""
  if [ -n "$IMPLEMENTER_MODEL" ]; then
    MODEL_FLAG="--model $IMPLEMENTER_MODEL"
  fi

  gemini $MODEL_FLAG -p "Run the SpecDD implementer protocol for task $TASK_ID. Follow GEMINI.md exactly. Call start_task($TASK_ID), then proceed through plan approval (if required), Red/Green/Refactor coding, and finally complete_task or escalate_task. Use complete_task tool errors to drive retry: if tests fail, fix the code and call complete_task again. Exit when the tool call returns submitted, done, or escalated."

  # Check final state
  STATUS_SQL="SELECT status FROM tasks WHERE id=$TASK_ID"
  if ! STATUS=$(_query "$STATUS_SQL" 2>&1); then
    echo "[$(date +%H:%M:%S)] DB query failed: $STATUS. Pausing."
    exit 1
  fi

  if [ -z "$STATUS" ]; then
    echo "[$(date +%H:%M:%S)] Task #$TASK_ID not found. DB inconsistency. Pausing."
    exit 1
  fi

  case "$STATUS" in
    DONE)
      echo "[$(date +%H:%M:%S)] Task #$TASK_ID complete."
      ;;
    AWAITING_APPROVAL)
      echo "[$(date +%H:%M:%S)] Plan for #$TASK_ID awaiting approval."
      echo "  Run: specdd plans pending"
      echo "  Then: specdd approve $TASK_ID"
      exit 0
      ;;
    ESCALATED)
      echo "[$(date +%H:%M:%S)] Task #$TASK_ID escalated."
      echo "  Run: specdd resolve $TASK_ID"
      exit 0
      ;;
    PLANNING|IN_PROGRESS)
      echo "[$(date +%H:%M:%S)] Task #$TASK_ID stuck in $STATUS. Gemini exited without resolution."
      echo "  Check: specdd logs show $TASK_ID"
      exit 1
      ;;
    *)
      echo "[$(date +%H:%M:%S)] Unexpected status '$STATUS' for #$TASK_ID. Pausing."
      exit 1
      ;;
  esac
done
